		{
			x: 6.0d
			y: 0.0d
			id: "CCCC495133ABDC4C"
			title: "Enchant It First"
			description: ["QuarryPlus machines carry enchantments, and you apply them to the ITEM", "in an anvil BEFORE you place the block.", "", "Quarry and Chunk Destroyer take Efficiency, Unbreaking, Fortune and Silk", "Touch. Advanced Pump takes Efficiency, Unbreaking and Fortune.", "", "Efficiency is speed, Unbreaking cuts energy cost, and Fortune and Silk", "Touch do exactly what they do on a pickaxe. Silk Touch and Fortune", "conflict -- pick one."]
			dependencies: ["BF8180F1D0C8B5D9"]
			tasks: [
				{
					id: "51D1B8F7BDDAC51D"
					type: "checkmark"
					title: "Place a quarry that has an enchantment on it"
