		}
		{
			x: 6.0d
			y: -2.0d
			id: "CC5F103D53B63CE6"
			title: "Two Reasons It Stopped"
			description: ["'Area is too small' means the markers do not enclose enough space.", "", "'Area contains protected chunks. Quarry has stopped.' means the dig", "region overlaps an FTB Chunks claim that is not yours. A quarry will not", "eat another team's claim, and it will not warn you until it hits one.", "", "Chunk-align the markers and claim the whole dig before you start."]
			dependencies: ["CCCC495133ABDC4C"]
