		{
			x: 4.0d
			y: 0.0d
			id: "BF8180F1D0C8B5D9"
			title: "Quarry Plus"
			description: ["Two gold pickaxes, a dropper, a redstone block, iron and obsidian.", "", "Place the quarry TOUCHING a marker and the marker's area becomes the dig", "area. It builds a frame around the region, then strips everything inside", "down to bedrock and pushes the drops into whatever inventory it faces.", "", "It needs energy -- the same FE Powah makes. Feed it a cable, not a hope."]
			dependencies: ["0BD4215CB44FE3AD"]
			tasks: [
				{
					id: "9758C0DEA6DD4FC0"
