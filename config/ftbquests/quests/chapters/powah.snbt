		{
			x: 10.0d
			y: 0.0d
			id: "00C45A99842832AF"
			title: "The Orb"
			description: ["The Energizing Orb is Powah's crafting machine, and it is a multiblock", "of a sort: the orb itself uses NO energy. The rods do the work.", "", "Place the orb, then place Energizing Rods within range -- they link", "automatically. Each rod must sit on a cable or an energy block.", "", "Throw or right-click ingredients into the orb. More rods, and higher tier", "rods, mean faster crafts. One rod works; it is just slow."]
			dependencies: ["2E5FBA945180E655"]
