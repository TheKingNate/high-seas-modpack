		{
			x: 18.0d
			y: 0.0d
			id: "8C92A071EE7AC1EE"
			title: "The Reactor"
			description: ["A real multiblock. Hold THIRTY-SIX Reactor blocks and place them into a", "3x4 clear area -- the reactor assembles itself from your hand.", "", "It burns Uraninite. Running heats it up, and a hot reactor eats more fuel", "for less output, so it needs water piped in as coolant. Snow or ice adds", "extra cooling, but only on top of a liquid coolant, never instead of it.", "", "Keep the fuel buffer full. A starved reactor produces almost nothing."]
			dependencies: ["1FB79A8983F8673F"]
